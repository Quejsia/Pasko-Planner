#!/bin/sh
# Blocks commits that include .env files or obvious secrets.
bad=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$')
if [ -n "$bad" ]; then
  echo "BLOCKED: secret file staged:"; echo "$bad"
  echo "Run: git restore --staged <file>"; exit 1
fi
if git diff --cached -U0 -- . ':(exclude).githooks' | grep -E '^\+' | grep -Eiq 'service_role[^a-z].*eyJ|SUPABASE_SERVICE_ROLE_KEY *= *[A-Za-z0-9]|BEGIN (RSA |EC )?PRIVATE KEY'; then
  echo "BLOCKED: possible secret (service role key or private key) in staged changes."; exit 1
fi
exit 0
